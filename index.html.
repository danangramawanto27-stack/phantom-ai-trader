
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Phantom AI Trader</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090d18;color:#edf2ff;font-family:Arial,sans-serif}
header{padding:22px;background:#111a2b;border-bottom:1px solid #26334b}
.logo{font-size:23px;font-weight:bold;color:#9b8cff}
.sub{color:#8795ad;font-size:12px;margin-top:6px}
main{padding:18px;max-width:1050px;margin:auto}
h2{font-size:17px;margin:24px 0 12px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.card{background:#131d30;border:1px solid #293751;border-radius:13px;padding:16px}
.label{font-size:12px;color:#94a3bd}
.value{font-size:23px;font-weight:bold;margin-top:9px}
.green{color:#37d99b}
.purple{color:#a99aff}
.muted{color:#8795ad}
button{border:0;border-radius:9px;padding:13px 16px;font-weight:bold;cursor:pointer}
.primary{background:#8872ff;color:white}
.secondary{background:#26344e;color:white}
input{width:100%;padding:12px;background:#0b1425;color:white;border:1px solid #35435d;border-radius:8px;margin:8px 0 14px}
.status{display:inline-block;background:#473b16;color:#ffda75;padding:6px 10px;border-radius:20px;font-size:11px}
table{width:100%;border-collapse:collapse;font-size:12px}
td,th{text-align:left;padding:13px 7px;border-bottom:1px solid #293751}
th{color:#91a0ba}
.actions{display:flex;gap:9px;flex-wrap:wrap}
footer{text-align:center;padding:25px;color:#72819c;font-size:11px}
@media(min-width:650px){.grid{grid-template-columns:repeat(4,1fr)}}
</style>
</head>
<body>
<header>
 <div class="logo">◈ PHANTOM AI TRADER</div>
 <div class="sub">SOLANA • PUMP.FUN • TRADING DASHBOARD</div>
</header>
<main>
 <span class="status">● PAPER TRADING MODE</span>
 <h2>Dashboard Overview</h2>
 <div class="grid">
  <div class="card"><div class="label">Wallet Balance</div><div class="value purple">1.00 SOL</div><div class="sub">Simulated balance</div></div>
  <div class="card"><div class="label">Total Profit / Loss</div><div class="value green" id="pnl">+0.000 SOL</div><div class="sub">Paper trading</div></div>
  <div class="card"><div class="label">Open Positions</div><div class="value" id="positions">0</div></div>
  <div class="card"><div class="label">Bot Status</div><div class="value" id="botStatus">STOPPED</div></div>
 </div>

 <h2>Trading Control</h2>
 <div class="card">
  <div class="label">Budget simulasi (SOL)</div>
  <input id="budget" type="number" value="1" min="0.01" max="1" step="0.01">
  <div class="label">Maximum trade per token (SOL)</div>
  <input id="tradeSize" type="number" value="0.05" min="0.01" max="1" step="0.01">
  <div class="actions">
   <button class="primary" onclick="startBot()">START PAPER BOT</button>
   <button class="secondary" onclick="stopBot()">STOP BOT</button>
  </div>
  <p class="sub" id="message">Bot belum berjalan.</p>
 </div>

 <h2>Token Scanner</h2>
 <div class="card">
  <div class="label">Pemantauan token Pump.fun</div>
  <p class="muted">Scanner ini masih berupa contoh tampilan. Belum mengambil data pasar langsung.</p>
  <button class="secondary" onclick="scan()">SIMULATE SCAN</button>
  <table>
   <thead><tr><th>Token</th><th>Market Cap</th><th>Status</th></tr></thead>
   <tbody id="tokens">
    <tr><td>Example SOL</td><td>Demo</td><td class="green">Watch</td></tr>
   </tbody>
  </table>
 </div>

 <h2>Risk Management</h2>
 <div class="grid">
  <div class="card"><div class="label">Stop Loss</div><div class="value">10%</div></div>
  <div class="card"><div class="label">Take Profit</div><div class="value">20%</div></div>
  <div class="card"><div class="label">Max Positions</div><div class="value">3</div></div>
  <div class="card"><div class="label">Trading Mode</div><div class="value purple">PAPER</div></div>
 </div>
 <h2>Activity Log</h2>
 <div class="card" id="logs"><p class="sub">Dashboard berhasil dimuat.</p></div>
</main>
<footer>PHANTOM AI TRADER • DEMO VERSION • NO LIVE TRANSACTIONS</footer>
<script>
let running=false;
let count=0;
function log(t){
 document.getElementById("logs").innerHTML=
 "<p class='sub'>"+new Date().toLocaleTimeString()+" — "+t+"</p>"+
 document.getElementById("logs").innerHTML;
}
function startBot(){
 let b=Number(document.getElementById("budget").value);
 let s=Number(document.getElementById("tradeSize").value);
 if(b<=0||b>1||s<=0||s>b){
  alert("Periksa kembali budget. Maksimal 1 SOL untuk pengujian.");
  return;
 }
 running=true;
 document.getElementById("botStatus").textContent="RUNNING";
 document.getElementById("message").textContent="Paper bot aktif. Tidak ada transaksi sungguhan.";
 log("Paper bot started.");
}
function stopBot(){
 running=false;
 document.getElementById("botStatus").textContent="STOPPED";
 document.getElementById("message").textContent="Bot dihentikan.";
 log("Paper bot stopped.");
}
function scan(){
 const names=["SOL Demo","Pump Example","Meme Test","Token Sample"];
 const name=names[Math.floor(Math.random()*names.length)];
 document.getElementById("tokens").innerHTML=
 "<tr><td>"+name+"</td><td>Demo only</td><td class='green'>Watch</td></tr>";
 log("Simulated scan completed.");
}
</script>
</body>
</html>
